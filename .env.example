# Copy this file to .env and fill it in. NEVER commit .env to GitHub.

# --- Angel One SmartAPI (live MCX prices) ---
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=          # the secret behind your authenticator QR code, not a 6-digit code
SERVER_PUBLIC_IP=           # the Static IP registered on the SmartAPI app (Elastic IP); blank = auto-detect

# --- Paper wallet and rules ---
START_CAPITAL=60000
MARGIN_PCT=10               # exchange margin as % of contract value (Kite order window margin / price x 100)
MARGIN_BUFFER_PCT=25        # extra cushion: MCX can raise margins overnight
LOTS=2
ROLL_DAYS=10                # switch contract when fewer than this many trading days remain
ROLL_TIME=21:00             # course: roll between 9:00 PM and 10:30 PM
MCX_HOLIDAYS=               # comma-separated dates, e.g. 2026-12-25,2027-01-26

# --- Telegram alerts (optional) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Google Sheets (optional) ---
GOOGLE_CREDS_FILE=          # path to the service-account JSON, e.g. secrets/google.json
GOOGLE_SHEET_ID=            # the long id in the sheet's URL
GOOGLE_SHEET_TAB=Gold Ten Fut

# --- Files ---
DB_PATH=data/goldten.db
LOG_DIR=logs
